K9!
# SPDX-License-Identifier: MPL-2.0
# expect: does not parse
metadata:
  schema: k9-coordination
  schema_version: 1.3.0
project:
  name: "fixture"
invariants:

reach:
  contract_id: K9R-sample
  serial: 1
  supersedes: "none"
  valid_from: 2026-11-21
  expires: 2026-12-21
  default: deny
  approved_by: owner
  selector_ref: "fixture only, not a live contract"
  roles:
    - role: deed-migrator
      grants:
        - repo: hyperpolymath/rsr-template-repo
          access: write
          actions:
            - attach
            - push_branch
            - open_draft_pr
            - approve
          branch: claude/*
          paths:
            - docs/*
            - README.adoc
            - .machine_readable/*
          max_files_per_push: 40
        - repo: metadatastician/standards
          access: read
          actions:
            - attach
      limits:
        window:
          days:
            - mon
            - tue
            - wed
            - thu
            - fri
          hours_utc: 7-21
          blackout:
            - 2026-12-01..2026-12-02
          scope: actions
        extent:
          max_orgs: 2
          max_repos: 3
          spawn_depth: 0
          spawn_breadth: 0
        ttl:
          wall_minutes: 240
          idle_minutes: 60
          max_tool_calls: 800
          max_attaches: 3
          max_pushes: 10
          max_prs: 2
        rate:
          pushes_per_hour: 6
        on_breach: deny_and_report
      never:
        - merge
        - force_push
        - delete_branch
        - close_pr

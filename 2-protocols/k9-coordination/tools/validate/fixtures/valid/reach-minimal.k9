K9!
# SPDX-License-Identifier: MPL-2.0
# Fixture: the smallest reach section, one role, one read grant, no limits.
metadata:
  schema: k9-coordination
  schema_version: 1.3.0
project:
  name: "fixture"
invariants:

coordination:
  available:
    - "reach follows coordination"

reach:
  contract_id: K9R-min
  serial: 1
  valid_from: 2026-11-21
  expires: 2026-11-22
  default: deny
  approved_by: owner
  selector_ref: "fixture"
  roles:
    - role: auditor
      grants:
        - repo: hyperpolymath/k9-ecosystem
          access: read
          actions:
            - attach

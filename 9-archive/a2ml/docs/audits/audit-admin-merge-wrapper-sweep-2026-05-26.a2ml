[manifest]
schema           = "audit/admin-merge-campaign/v1"
date             = "2026-05-26"
session_id       = "01a0eaa4-72db-75ee-af38-71c9e179181a"
campaign_kind    = "estate_ci_wrapper_sweep + admin_merge"

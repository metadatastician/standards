; CRG-TRG-RSR Interoperability Mapping
; Defines formal relationships between Component Readiness Grades,
; Toolchain Readiness Grades, and Rhodium Standard Repository compliance

(interop-spec
  (name "CRG-TRG-RSR Mapping")
  (version "1.0.0")
  (date "2026-04-15")
  (purpose "Ensure consistent interpretation across standards"))

(mappings
  ; CRG to RSR compliance requirements
  (crg-rsr
    (grade X
      (rsr-requirement #f)
      (justification "Untested components have no compliance requirements"))
    (grade F
      (rsr-requirement #f)
      (justification "Harmful components should be removed, not certified"))
    (grade E
      (rsr-requirement "Bronze")
      (justification "Minimal functionality requires basic repository hygiene"))
    (grade D
      (rsr-requirement "Bronze")
      (justification "Partial functionality needs structured repository"))
    (grade C
      (rsr-requirement "Silver")
      (justification "Self-validated components require governance documentation"))
    (grade B
      (rsr-requirement "Gold")
      (justification "Broad validation requires full RSR compliance"))
    (grade A
      (rsr-requirement "Rhodium")
      (justification "Field-proven components should be exemplary")))

  ; TRG to RSR compliance requirements
  (trg-rsr
    (grade X
      (rsr-requirement #f)
      (justification "Untested toolchains have no compliance requirements"))
    (grade F
      (rsr-requirement #f)
      (justification "Harmful toolchains should be rejected"))
    (grade E
      (rsr-requirement "Bronze")
      (justification "Bare minimum requires basic repository structure"))
    (grade D
      (rsr-requirement "Silver")
      (justification "Should-have complete requires governance"))
    (grade C
      (rsr-requirement "Gold")
      (justification "Alpha release requires full RSR compliance"))
    (grade B
      (rsr-requirement "Gold")
      (justification "Beta release maintains Gold compliance"))
    (grade A
      (rsr-requirement "Rhodium")
      (justification "Stable release should be exemplary")))

  ; CRG to TRG relationships
  (crg-trg
    (crg-grade C
      (trg-equivalent "E")
      (justification "Self-validated component ≈ bare minimum toolchain"))
    (crg-grade B
      (trg-equivalent "C")
      (justification "Broadly validated component ≈ self-validated toolchain"))
    (crg-grade A
      (trg-equivalent "B")
      (justification "Field-proven component ≈ broadly validated toolchain")))

  ; Version compatibility matrix
  (version-compatibility
    (crg "2.0"
      (compatible-trg "1.0")
      (compatible-rsr "1.0")
      (notes "Full compatibility with current TRG and RSR versions"))
    (trg "1.0"
      (compatible-crg "2.0")
      (compatible-rsr "1.0")
      (notes "Designed for CRG v2.0 and RSR v1.0"))
    (rsr "1.0"
      (compatible-crg "2.0")
      (compatible-trg "1.0")
      (notes "Supports current CRG and TRG versions")))

(compliance-rules
  (rule-1
    (description "RSR Gold required for CRG B and TRG C")
    (rationale "Beta/alpha releases need full compliance")
    (enforcement "Automatic via rsr-certifier"))
  
  (rule-2
    (description "CRG D+ requires at least RSR Bronze")
    (rationale "Partial functionality needs basic hygiene")
    (enforcement "CI/CD gate"))
    
  (rule-3
    (description "TRG E+ requires at least RSR Bronze")
    (rationale "Bare minimum toolchains need structure")
    (enforcement "Repository setup validation"))

(validation
  (automated-checks
    (item "rsr-certifier validate --crg-grade [grade] --trg-grade [grade]")
    (item "CI/CD integration via GitHub action")
    (item "Pre-commit hook for local validation"))
  
  (manual-review
    (item "Quarterly compliance audit")
    (item "Grade promotion review")
    (item "Demotion trigger assessment")))

(examples
  (scenario-1
    (description "Component at CRG B")
    (requires
      (item "RSR Gold compliance")
      (item "TRG C equivalent toolchain")
      (item "6+ diverse targets"))
    (validation
      (item "rsr-certifier check --tier gold")
      (item "trg-auditor validate --grade C")))

  (scenario-2
    (description "Toolchain at TRG D")
    (requires
      (item "RSR Silver compliance")
      (item "Canonical proof suite passing")
      (item "RSR-FULL not yet required"))
    (validation
      (item "rsr-certifier check --tier silver")
      (item "proof-suite-validator run"))))

(change-management
  (versioning
    (policy "Semantic versioning for this mapping spec")
    (backward-compatibility "Maintained within major version")
    (deprecation-period "12 months for major changes"))
  
  (change-process
    (minor "Maintainer approval + CI pass")
    (major "RFC + 2/3 maintainer vote + 30-day comment period")))

(references
  (item "CRG v2.0: standards/crg/COMPONENT-READINESS-GRADES.a2ml")
  (item "TRG v1.0: standards/trg/TOOLCHAIN-READINESS-GRADES.a2ml")
  (item "RSR v1.0: rsr-engine-repo/spec/RSR-SPEC.adoc")
  (item "RSR Tiers: rsr-engine-repo/spec/TIERS.adoc"))
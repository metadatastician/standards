; Template Versioning Specification
; Formal versioning policy for all standards templates

(versioning-spec
  (name "Template Versioning Standard")
  (version "1.0.0")
  (date "2026-04-15")
  (purpose "Ensure consistent template evolution across standards"))

(versioning-policy
  (semantic-versioning
    (description "All templates follow Semantic Versioning 2.0.0")
    (format "MAJOR.MINOR.PATCH")
    (rules
      (major "Breaking changes to template structure or requirements")
      (minor "Backward-compatible feature additions")
      (patch "Backward-compatible bug fixes")))

  (version-location
    (description "Template versions must be declared in machine-readable format")
    (a2ml-templates
      (item "Version declared in template header comment")
      (item "Format: ; Template: NAME vMAJOR.MINOR.PATCH"))
    (markdown-templates
      (item "Version declared in frontmatter")
      (item "Format: template-version: MAJOR.MINOR.PATCH"))
    (shell-templates
      (item "Version declared in header comment")
      (item "Format: # Template: NAME vMAJOR.MINOR.PATCH")))

  (compatibility-guarantees
    (description "Version compatibility rules")
    (backward-compatibility
      (item "PATCH updates: Fully backward compatible")
      (item "MINOR updates: Backward compatible, may add optional fields")
      (item "MAJOR updates: May break compatibility, requires migration"))
    (deprecation-period
      (item "MINOR version: Supported for 12 months after next MINOR release")
      (item "MAJOR version: Supported for 24 months after next MAJOR release"))
    (migration-path
      (item "Provide migration guides for MAJOR version changes")
      (item "Maintain conversion scripts where possible")
      (item "Document breaking changes prominently")))

(template-types
  (a2ml-templates
    (description "A2ML document templates")
    (examples
      (item "META.a2ml.template")
      (item "STATE.a2ml.template")
      (item "ECOSYSTEM.a2ml.template"))
    (versioning
      (item "Follows A2ML version when possible")
      (item "Independent version when template-specific changes occur")))

  (contractile-templates
    (description "K9 contract templates")
    (examples
      (item "template-kennel.k9.ncl")
      (item "template-yard.k9.ncl")
      (item "template-hunt.k9.ncl"))
    (versioning
      (item "Tied to K9 specification version")
      (item "Independent version for template-specific evolution")))

  (repository-templates
    (description "Repository scaffolding templates")
    (examples
      (item "justfile.template")
      (item "setup.sh.template")
      (item "0-canon/GOVERNANCE.adoc.template"))
    (versioning
      (item "Tied to RSR specification version")
      (item "Independent version for template improvements")))

  (ci-cd-templates
    (description "CI/CD configuration templates")
    (examples
      (item ".gitlab-ci.yml.template")
      (item "rsr-antipattern.yml")
      (item "compliance-workflow.yml"))
    (versioning
      (item "Independent versioning")
      (item "Tied to CI/CD platform versions when relevant")))

(change-process
  (minor-changes
    (description "Backward-compatible modifications")
    (process
      (item "Submit pull request with version bump")
      (item "Maintainer approval required")
      (item "CI/CD validation must pass")
      (item "Document changes in template CHANGELOG"))
    (examples
      (item "Adding optional fields to A2ML template")
      (item "Improving comments/documentation")
      (item "Adding new optional sections")))

  (major-changes
    (description "Breaking changes requiring migration")
    (process
      (item "Create RFC document")
      (item "30-day comment period")
      (item "2/3 maintainer approval required")
      (item "Provide migration guide")
      (item "Update all dependent templates")
      (item "Document in template CHANGELOG"))
    (examples
      (item "Removing required fields")
      (item "Changing template structure")
      (item "Modifying validation rules")))

  (emergency-fixes
    (description "Critical bug fixes")
    (process
      (item "Immediate PATCH version bump")
      (item "Single maintainer approval sufficient")
      (item "Full disclosure of issue and fix")
      (item "Backport to previous versions if applicable"))
    (examples
      (item "Security vulnerabilities")
      (item "Compliance validation bugs")
      (item "Template generation failures")))

(template-registry
  (description "Central registry of available templates")
  (structure
    (item "JSON format registry file")
    (item "Versioned template references")
    (item "Compatibility metadata")
    (item "Location pointers"))
  (example-registry
    (item "{")
    (item "  \"a2ml\": {")
    (item "    \"version\": \"1.2.0\",")
    (item "    \"path\": \"git@github.com:hyperpolymath/a2ml-repo.git//RSR-TEMPLATES\",")
    (item "    \"templates\": [\"META.a2ml\", \"STATE.a2ml\", \"ECOSYSTEM.a2ml\"]")
    (item "  },")
    (item "  \"k9\": {")
    (item "    \"version\": \"2.1.0\",")
    (item "    \"path\": \"git@github.com:hyperpolymath/k9-svc-repo.git//templates\",")
    (item "    \"templates\": [\"kennel.k9.ncl\", \"yard.k9.ncl\", \"hunt.k9.ncl\"]")
    (item "  },")
    (item "  \"rsr\": {")
    (item "    \"version\": \"3.0.0\",")
    (item "    \"path\": \"./templates\",")
    (item "    \"templates\": [\"justfile\", \"setup.sh\", \"0-canon/GOVERNANCE.adoc\"]")
    (item "  }")
    (item "}")))

(validation-rules
  (template-validation
    (description "Rules for validating template compliance")
    (requirements
      (item "Version declared in machine-readable format")
      (item "Complies with specified template type rules")
      (item "Passes schema validation if schema exists")
      (item "Contains required metadata fields"))
    (automated-checks
      (item "rsr-certifier validate-template --type a2ml META.a2ml.template")
      (item "template-linter check --version 1.2.0 template-file")
      (item "CI/CD integration via template-validation action")))

  (registry-validation
    (description "Rules for validating template registry")
    (requirements
      (item "All referenced templates exist")
      (item "Version format valid")
      (item "No duplicate template names")
      (item "Paths accessible"))
    (automated-checks
      (item "rsr-certifier validate-registry template-registry.json")
      (item "registry-linter check --strict registry.json")))

(compliance-matrix
  (rsr-tiers
    (bronze
      (template-requirements
        (item "Basic template structure")
        (item "Version declared")
        (item "Required fields present")))
    (silver
      (template-requirements
        (item "All Bronze requirements")
        (item "Optional fields documented")
        (item "Validation rules included")))
    (gold
      (template-requirements
        (item "All Silver requirements")
        (item "Machine-readable metadata")
        (item "Change history included")
        (item "Compatibility notes")))
    (rhodium
      (template-requirements
        (item "All Gold requirements")
        (item "Formal specification")
        (item "Automated validation")
        (item "Community review process"))))

(migration-guide
  (from-v0.x
    (description "Migrating from unversioned templates")
    (steps
      (item "Add version declaration to template")
      (item "Document template purpose and usage")
      (item "Register template in registry.json")
      (item "Set initial version to 1.0.0")
      (item "Create CHANGELOG.md for template")))

  (major-version-upgrade
    (description "Upgrading to new MAJOR version")
    (steps
      (item "Review migration guide for breaking changes")
      (item "Run automated migration script if available")
      (item "Manually update required fields")
      (item "Test template generation")
      (item "Update version reference in registry")))

  (deprecation-process
    (description "Handling deprecated templates")
    (steps
      (item "12-month deprecation notice period")
      (item "Clear migration path provided")
      (item "Warnings in template documentation")
      (item "CI/CD warnings during deprecation period")
      (item "Final removal after deprecation period")))

(references
  (item "Semantic Versioning 2.0.0: https://semver.org/")
  (item "RSR Specification: rsr-engine-repo/spec/RSR-SPEC.adoc")
  (item "A2ML Specification: a2ml-repo/spec/A2ML-SPEC.a2ml")
  (item "K9 Specification: k9-svc-repo/spec/K9-SPEC.a2ml")
  (item "Template Registry: rsr-engine-repo/templates/registry.json"))

(appendix
  (template-changelog-format
    (description "Standard format for template CHANGELOG files")
    (format
      (item "# Changelog")
      (item "")
      (item "## [1.2.0] - 2026-04-15")
      (item "### Added")
      (item "- Optional `metadata` field for additional context")
      (item "### Changed")
      (item "- Improved validation error messages")
      (item "### Fixed")
      (item "- Corrected schema validation for `dependencies` field")))

  (version-declaration-examples
    (a2ml
      (item "; Template: META.a2ml v1.2.0")
      (item "; Purpose: Architecture decision tracking")
      (item "; Compatibility: RSR Gold+"))
    (markdown
      (item "---")
      (item "template: 0-canon/GOVERNANCE.adoc")
      (item "version: 2.1.0")
      (item "rsr-tier: Silver+")
      (item "---"))
    (shell
      (item "# Template: setup.sh v3.0.0")
      (item "# Purpose: Repository initialization")
      (item "# Requirements: bash 4.0+, git 2.0+")))

  (registry-management
    (description "Best practices for registry maintenance")
    (practices
      (item "Update registry when new template version released")
      (item "Remove deprecated template versions after deprecation period")
      (item "Document template compatibility requirements")
      (item "Validate registry periodically via CI/CD"))))
; K9 Automation Interface Specification
; Formal definition of K9 self-validating component automation interfaces

(automation-spec
  (name "K9 Automation Interface")
  (version "1.0.0")
  (date "2026-04-15")
  (purpose "Standardize K9 automation hooks for CRG/TRG/RSR integration"))

(interface-definitions
  ; Safety level interfaces
  (kennel-interface
    (description "Pure data components - read-only operations")
    (methods
      (validate-data
        (input "data: JSON")
        (output "valid: Boolean")
        (side-effects "none"))
      (get-metadata
        (input "none")
        (output "metadata: JSON")
        (side-effects "none")))
    (safety-guarantees
      (item "No filesystem writes")
      (item "No network access")
      (item "No process execution")
      (item "Deterministic output")))

  (yard-interface
    (description "Configuration components - limited side effects")
    (methods
      (apply-config
        (input "config: JSON, target: String")
        (output "result: JSON")
        (side-effects "configuration files only"))
      (validate-config
        (input "config: JSON")
        (output "valid: Boolean, errors: [String]")
        (side-effects "none")))
    (safety-guarantees
      (item "No arbitrary code execution")
      (item "No network mutations")
      (item "No database writes")
      (item "Idempotent operations")))

  (hunt-interface
    (description "Deployment components - full capabilities")
    (methods
      (execute-deployment
        (input "plan: JSON, environment: String")
        (output "result: JSON")
        (side-effects "full system access"))
      (rollback
        (input "deployment-id: String, target-state: String")
        (output "success: Boolean")
        (side-effects "system state changes")))
    (safety-guarantees
      (item "Cryptographic signature verification")
      (item "Audit trail generation")
      (item "Pre-flight validation")
      (item "Rollback capability")))

(crg-integration
  (grade-promotion-hooks
    (description "K9 contracts for CRG grade promotion validation")
    (examples
      (item "Grade B promotion: validate 6+ diverse targets meet diversity-metrics")
      (item "Grade C promotion: verify dogfooding evidence and CI integration")
      (item "Grade D promotion: validate matrix testing and scope documentation"))
    (interface
      (method "validate-promotion")
      (input "current-grade: Char, target-grade: Char, evidence: JSON")
      (output "valid: Boolean, requirements-met: [String], missing: [String]")
      (safety-level "Yard")))

(trg-integration
  (compliance-hooks
    (description "K9 contracts for TRG compliance checking")
    (examples
      (item "Grade C promotion: validate 10 dogfood users meet diversity-metrics")
      (item "Grade B promotion: verify 6 downstream targets and 100 external users")
      (item "Grade D promotion: validate canonical proof suite and RSR-FULL compliance"))
    (interface
      (method "validate-compliance")
      (input "grade: Char, component: String, evidence: JSON")
      (output "compliant: Boolean, compliance-report: JSON")
      (safety-level "Yard")))

(rsr-integration
  (compliance-hooks
    (description "K9 contracts for RSR compliance validation")
    (examples
      (item "Bronze validation: check required files and CI/CD presence")
      (item "Silver validation: verify governance docs and Scorecard 7.0+")
      (item "Gold validation: confirm A2ML files and Scorecard 9.0+")
      (item "Rhodium validation: check formal verification and community recognition"))
    (interface
      (method "validate-rsr-tier")
      (input "tier: String, repository: String")
      (output "compliant: Boolean, score: Number, report: JSON")
      (safety-level "Kennel")))

(ci-cd-integration
  (github-action-interface
    (description "Standard interface for GitHub Actions")
    (inputs
      (item "k9-contract: String (path to .k9.ncl file)")
      (item "safety-level: String (kennel|yard|hunt)")
      (item "evidence-dir: String (path to evidence files)")
      (item "grade-target: String (optional CRG/TRG grade)"))
    (outputs
      (item "validation-passed: Boolean")
      (item "compliance-report: JSON")
      (item "audit-trail: JSON"))
    (example-usage
      (item "- uses: hyperpolymath/k9-validation-action@v1")
      (item "  with:")
      (item "    k9-contract: '.k9/grade-promotion.k9.ncl'")
      (item "    safety-level: 'yard'")
      (item "    evidence-dir: '.evidence/crg'")
      (item "    grade-target: 'B'")))

  (gitlab-ci-interface
    (description "Standard interface for GitLab CI")
    (variables
      (item "K9_CONTRACT: path to contract file")
      (item "K9_SAFETY_LEVEL: kennel|yard|hunt")
      (item "K9_EVIDENCE_DIR: path to evidence")
      (item "K9_GRADE_TARGET: optional grade target"))
    (artifacts
      (item "compliance-report.json")
      (item "audit-trail.json")
      (item "validation-summary.txt")))

(safety-level-matrix
  (crg-requirements
    (grade X "Kennel")
    (grade F "Kennel")
    (grade E "Kennel")
    (grade D "Yard")
    (grade C "Yard")
    (grade B "Hunt")
    (grade A "Hunt"))

  (trg-requirements
    (grade X "Kennel")
    (grade F "Kennel")
    (grade E "Yard")
    (grade D "Yard")
    (grade C "Hunt")
    (grade B "Hunt")
    (grade A "Hunt"))

  (rsr-requirements
    (tier "Bronze" "Kennel")
    (tier "Silver" "Yard")
    (tier "Gold" "Hunt")
    (tier "Rhodium" "Hunt")))

(validation-protocol
  (pre-flight-checks
    (item "Contract signature verification")
    (item "Safety level compatibility check")
    (item "Evidence directory validation")
    (item "Grade target validation"))

  (execution-phases
    (phase-1
      (name "Contract Loading")
      (actions
        (item "Parse contract file")
        (item "Verify contract structure")
        (item "Check safety level constraints")))
    
    (phase-2
      (name "Evidence Collection")
      (actions
        (item "Gather evidence files")
        (item "Validate evidence format")
        (item "Check evidence completeness")))
    
    (phase-3
      (name "Validation Execution")
      (actions
        (item "Run contract validation")
        (item "Generate compliance report")
        (item "Create audit trail")))
    
    (phase-4
      (name "Result Reporting")
      (actions
        (item "Output validation result")
        (item "Store compliance report")
        (item "Export audit trail"))))

(error-handling
  (recoverable-errors
    (item "Missing evidence files")
    (item "Invalid evidence format")
    (item "Grade target mismatch")
    (recovery "Provide detailed error report, suggest fixes"))

  (non-recoverable-errors
    (item "Invalid contract signature")
    (item "Safety level violation")
    (item "Contract structure corruption")
    (recovery "Fail fast with security alert")))

(change-management
  (versioning
    (policy "Semantic versioning")
    (backward-compatibility "Maintained within major version")
    (deprecation-period "12 months"))

  (change-process
    (minor "Maintainer approval + test suite pass")
    (major "RFC + 2/3 maintainer vote + 30-day comment period")))

(references
  (item "K9 Specification: k9-svc-repo/spec/K9-SPEC.a2ml")
  (item "CRG Automation: standards/crg/automation-hooks")
  (item "TRG Automation: standards/trg/automation-hooks")
  (item "RSR Certification: rsr-engine-repo/spec/RSR-CERTIFIER-SPEC.adoc"))
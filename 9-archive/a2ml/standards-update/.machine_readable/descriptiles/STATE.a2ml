# SPDX-License-Identifier: MPL-2.0
# STATE.a2ml - RSR State File
# Template from: https://github.com/hyperpolymath/standards
#
# HUMAN SUMMARY: This is your project's "status dashboard". It tells anyone
# (human or AI) where the project is right now — what phase it's in, what's
# been built, and what's next. Update it as work progresses.

# ── Project State ──────────────────────────────────────────────────────────
[state]
# version: Semantic version of this project (not the state file format).
version = "0.0.1"

# phase: What development stage is this project in?
#   concept  — idea only, no code yet
#   alpha    — early code, unstable APIs
#   beta     — feature-complete, testing
#   stable   — production-ready
#   mature   — long-term maintenance
phase = "initial"

# updated: ISO 8601 timestamp of last state change.
updated = "2026-03-16"

# ── Project Identity ───────────────────────────────────────────────────────
[state.project]
# name: Human-readable project name. Must match repo name.
name = "standards-update"

# tier: Where does this sit in the ecosystem?
#   core           — essential infrastructure, high stability bar
#   infrastructure — supporting tooling
#   experimental   — proof of concept, may be discarded
#   playground     — learning/sandbox, no stability promises
tier = "core"

# license: SPDX identifier. Almost always PMPL-1.0-or-later.
license = "MPL-2.0"

# language: Primary programming language used.
language = ""

# ── Compliance Flags ───────────────────────────────────────────────────────
[state.compliance]
rsr = true
security-hardened = true
ci-cd = true
guix-primary = false
nix-fallback = false

# ── Build Artifacts ────────────────────────────────────────────────────────
[state.artifacts]

# ── Dependencies ───────────────────────────────────────────────────────────
[state.dependencies]
build = []
runtime = []

# ── Milestones ─────────────────────────────────────────────────────────────
[state.milestones.v0_1_0]
status = "planned"
features = [
  "Initial framework",
  "Basic examples",
  "Documentation",
]

# ── Provenance ─────────────────────────────────────────────────────────────
[provenance]
# Audit trail — updated automatically by agents/bots on every write.
# Humans: you can ignore this section, but don't delete it.
last-modified-by = "claude-opus-4-6"
last-modified-at = "2026-03-16"
last-session-id = ""
git-sha-at-read = ""
modification-summary = "Migrated from STATE.scm to A2ML format"

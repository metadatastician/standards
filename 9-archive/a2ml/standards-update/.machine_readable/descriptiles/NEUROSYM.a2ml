# SPDX-License-Identifier: MPL-2.0
# NEUROSYM.a2ml - Neurosymbolic integration config
# Template from: https://github.com/hyperpolymath/standards
#
# HUMAN SUMMARY: This file configures the neurosymbolic layer — the bridge
# between symbolic reasoning (formal logic, proofs, type systems) and neural
# reasoning (LLMs, embeddings).

# ── Neurosymbolic Configuration ───────────────────────────────────────────
[neurosym-config]
version = "1.0.0"
project = "standards-update"

# ── Symbolic Layer ─────────────────────────────────────────────────────────
[neurosym-config.symbolic-layer]
type = "a2ml"
reasoning = "deductive"
verification = "formal"

# ── Language-Specific Symbolic Config ─────────────────────────────────────
[neurosym-config.symbolic-layer.language-specific]

# ── Neural Layer ──────────────────────────────────────────────────────────
[neurosym-config.neural-layer]
embeddings = false
fine-tuning = false
inference = false

# ── Integration ───────────────────────────────────────────────────────────
[neurosym-config.integration]

# ── Provenance ─────────────────────────────────────────────────────────────
[provenance]
last-modified-by = "claude-opus-4-6"
last-modified-at = "2026-03-16"
last-session-id = ""
git-sha-at-read = ""
modification-summary = "Migrated from NEUROSYM.scm to A2ML format"

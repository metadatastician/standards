;; SPDX-License-Identifier: CC-BY-SA-4.0
(repo-deed
  :schema-version "1.0.0"
  :canonical-name "standards"
  :repo-uuid #uuid"b32d6be4-73ba-873e-9d61-e57f43c75cd1"
  :beholding-chora #uuid"0889b37b-defb-831f-973c-e119500db00e"

  (purpose
    :text "The organization-wide standards monorepo: ~30 specs that govern every Hyperpolymath project — K9 self-validating components, the protocols, the readiness-grading frameworks (ARG/FRG/CRG/TRG), RSR compliance, and the enforcement/CI that makes them stick.")

  (front-doors
    :machine "standards_chora.deed"
    :human "README.adoc")

  (routing
    (k9-foundation :paths ("1-formats/k9/" "1-formats/contractiles/"))
    (language-policy :paths (".claude/CLAUDE.md"))
    (protocols :paths ("2-protocols/" "*-protocol/"))
    (readiness-grades :paths ("4-readiness/adoption-readiness-grades/" "4-readiness/foundations-readiness-grades/" "4-readiness/component-readiness-grades/" "4-readiness/toolchain-readiness-grades/"))
    (multi-repository-scope :paths ("docs/MULTI-REPOSITORY-SCOPE-STANDARD.adoc" "docs/repo-scope.example.toml"))
    (enforcement-ci :paths (".github/workflows/" "hooks/"))
    (drift-automation :paths ("hypatia-rules/" "docs/decisions/ADR-003-workflow-pin-staleness-window.adoc" "scripts/check-workflow-staleness.sh" "scripts/propagate-workflow-pins.sh"))
    (derived-architecture-map :paths ("TOPOLOGY.adoc"))
    (current-project-state :paths ("standards_chora.deed"))
    (education-layer :paths ("docs/wikis/" "docs/wikis/0.2-AI-MANIFEST.deed")))

  (invariants
    (rule :priority 10 :text "No A2ML/DEED duplication — root must NOT contain STATE.deed, META.deed, etc.")
    (rule :priority 20 :text "The repo deed routes to state evidence; generated metadata does not confer normative authority.")
    (rule :priority 30 :text "Initial licence assignment is permitted: agents may add the correct SPDX header to new files under the repository policy and set a brand-new repository's initial LICENSE. Changes to existing licences, LICENSE files or SPDX declarations are Manual-Only and restricted to registered codeowner-admins. Agents must flag licence drift for review; never sweep or relicense existing content. See LICENSE, .machine_readable/licensing-policy.toml, and .claude/CLAUDE.md.")
    (rule :priority 40 :text "Author attribution — Jonathan D.A. Jewell <j.d.a.jewell@open.ac.uk>")
    (rule :priority 50 :text "Never merge through a branch-ruleset bypass to get past a required status check. A bypass discards every required check in that ruleset in a single action, so using one converts the rest of the decision layer into advice. If a pull request is green everywhere and still BLOCKED, diagnose it with scripts/check-required-contexts.sh and consult the audit verdict before choosing a repair. UNSATISFIED-RULE for data-dependent code_coverage or code_quality rules calls for inspecting the required data and repository settings. When the verdict identifies an unproducible required context, repair the context with scripts/fix-required-context-name.sh (report-only by default) and flag it for a human to apply. Downgrading the gate — continue-on-error, || true, or a new line in .machine_readable/required-contexts-allow.txt — is not a repair. See docs/audits/audit-ci-context-producibility-2026-09-20.adoc."))

  (startup-checklist
    :steps ("Read THIS file, then README.adoc."
    "Read standards_chora.deed for repository metadata and state-source routing."
    "Read the (agentic) clause of standards_chora.deed for interaction patterns."
    "Read .claude/CLAUDE.md for the language + licence policy (binding)."))

  (attestation
    :text "I have read the standards manifest. The human front door is README.adoc. Licence/SPDX changes to existing files are Manual-Only and restricted to registered codeowner-admins — I will flag, never edit. I may add the correct SPDX header when creating a new file, following the repo's licence classification.")

  (meta
    :maintained-by "Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>"
    :protocol "https://github.com/hyperpolymath/0-ai-gatekeeper-protocol")
)

  :repo-uuid #uuid"b32d6be4-73ba-873e-9d61-e57f43c75cd1"
  :beholding-chora #uuid"1e207a32-dd26-8c8a-b8d9-5f77f88dbd58"
  (identity :aliases (#uuid"1e207a32-dd26-8c8a-b8d9-5f77f88dbd58" #u8"gv-clade-index:github.com/o/uuid-opaque")))

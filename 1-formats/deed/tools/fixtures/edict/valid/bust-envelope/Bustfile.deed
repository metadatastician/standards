(contractile-deed
  :schema-version "1.0.0"
  :canonical-name "example-game"
  :of-chora #uuid"00000000-0000-8000-8000-0000000000a1"
  :verb bust
  (envelope :not-for ("safety-critical") :tolerance "0.1")
  (rule :id "bust-oob-parser" :text "Parser bounds are checked." (applies-when (capabilities :parses-untrusted #t)) (requires (bust :witness "bust-oob-parser" :at-most "C2"))))

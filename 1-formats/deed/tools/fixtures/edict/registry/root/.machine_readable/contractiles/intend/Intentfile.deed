(contractile-deed
  :schema-version "1.0.0"
  :canonical-name "example-game"
  :of-chora #uuid"00000000-0000-8000-8000-0000000000a1"
  :verb intend
  (rule :id "int-playable" :text "A new player can finish the first level." (applies-when (always)) (requires (intend :witness "int-playable" :value #t))))

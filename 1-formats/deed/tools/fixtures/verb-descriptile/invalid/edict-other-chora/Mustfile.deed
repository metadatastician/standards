(contractile-deed
  :schema-version "1.0.0"
  :canonical-name "example-game"
  :of-chora #uuid"00000000-0000-8000-8000-0000000000b2"
  :verb must
  (rule :id "must-tests" :text "Core tests pass." (applies-when (always)) (requires (must :witness "must-tests" :value #t)))
  (rule :id "must-fmt" ! :text "Formatting is clean." (applies-when (context :path "src")) (requires (must :witness "must-fmt" :value #t))))

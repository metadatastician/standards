;; A worked proof receipt (PROOF-POLICY §8.5): one Agda leg with a current
;; receipt and a superseded one, both recheck legs unavailable, so every claim
;; derives to PWG-3. The run URLs and commits are illustrative.
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "example-proof-receipt"
  :beholding-chora #u5"estate/chora"
  :profile proof-receipt
  :repository "hyperpolymath/example"
  :source-commit "0123456789abcdef0123456789abcdef01234567"
  (trusted-base
    (primitive :prover agda :module "Agda.Primitive" :name "Level" :binding "BUILTIN LEVEL")
    (primitive :prover agda :module "Agda.Primitive" :name "lzero" :binding "BUILTIN LEVELZERO")
    (primitive :prover agda :module "Agda.Primitive" :name "lsuc" :binding "BUILTIN LEVELSUC")
    (primitive :prover agda :module "Agda.Primitive" :name "_⊔_" :binding "BUILTIN LEVELMAX"))
  (claim :id "T-1" :pwg PWG-3 :foundation-diverse #f
    (leg :prover agda :route source :token proven :state AGDA-VERIFIED
      (receipt :run "https://github.com/hyperpolymath/example/actions/runs/2"
               :commit "0123456789abcdef0123456789abcdef01234567"
               :checker "agda 2.6.4.3"
               :invocation "agda --safe --without-K --cubical-compatible"
               :state current)
      (receipt :run "https://github.com/hyperpolymath/example/actions/runs/1"
               :commit "fedcba9876543210fedcba9876543210fedcba98"
               :checker "agda 2.6.4.3"
               :invocation "agda --safe --without-K"
               :state superseded
               :reason "before --cubical-compatible joined the gate"))
    (leg :prover rocq :route unavailable :reason "no transport or hand re-proof yet")
    (leg :prover lean :route unavailable :reason "no transport or hand re-proof yet")))

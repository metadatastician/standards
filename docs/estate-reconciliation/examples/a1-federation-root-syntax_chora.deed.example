(estate-deed
  :schema-version "1.0.0"
  :canonical-name "hyperpolymath-federation"
  :estate-uuid #uuid"99fef1e9-e3a7-599b-ac66-1a4ae305f867"
  :kind federation
  :vocabulary-version "0.1.0"
  (vocabulary
    (term :name "chora" :kind type :gloss "a place with a role")
    (term :name "estate" :kind type :gloss "a set of repos under one co-authorship rule"))
  (invariants
    (rule :id "chora/vocabulary-at-root" :priority 10 :text "Vocabulary is declared here and nowhere else."))
  (estates
    (estate :name "hyperpolymath" :uuid #uuid"47e1501b-26b4-5bbd-8a3f-1afa81c69dbe"))
  ;; A root-level deviation (A5 5.2: :origins is allowed only at the root).
  (deviations
    (deviation
      :id "R-001"
      :kind exemption
      :rule "bot/write"
      :reason "Vendored upstream toolchain clone; bots must not write."
      :authority "owner/standards#99"
      :evidence measured
      :review-by "2027-06-01"
      (scope :origins ("github.com/upstream/*")))))

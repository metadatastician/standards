# SPDX-License-Identifier: MPL-2.0
# <default-branch> is generated from the repo's default branch; this repo's is main (A3 4.2).
name: Estate gate
on:
  pull_request:
    branches: ["main"]
  merge_group:
  push:
    branches: ["main"]
  workflow_run:
    workflows: ["Governance", "Hypatia Security Scan", "Secret Scanner"]
    types: [completed]
concurrency:
  group: estate-gate-${{ github.event.workflow_run.head_sha || github.event.pull_request.head.sha || github.sha }}
  cancel-in-progress: false
permissions:
  contents: read
  checks: read
  actions: read
  statuses: write
  id-token: write
jobs:
  gate:
    uses: hyperpolymath/proven-cicd/.github/workflows/estate-gate.yml@0123456789abcdef0123456789abcdef01234567
